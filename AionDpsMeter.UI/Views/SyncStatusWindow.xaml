<Window x:Class="AionDpsMeter.UI.Views.SyncStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sync popup"
        Width="300" Height="190"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <StackPanel VerticalAlignment="Top">
        <!-- Shown while Settings is open, so there's something to drag into place -->
        <Border x:Name="EditHint"
                Visibility="Collapsed"
                Background="#E6161B22"
                BorderBrush="#7EE787" BorderThickness="1"
                CornerRadius="6" Padding="10,8" Margin="0,0,0,6"
                Cursor="SizeAll">
            <StackPanel>
                <TextBlock Text="Sync popup" FontSize="12" FontWeight="Bold" Foreground="#7EE787"/>
                <TextBlock Text="Drag to move. Says when the meter has synced with the game and who you are, or what to do when it can't."
                           FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Border x:Name="Card"
                Visibility="{Binding IsShown, Converter={StaticResource BooleanToVisibilityConverter}}"
                Opacity="{Binding Opacity}"
                Background="#E6161B22"
                BorderBrush="{Binding BorderColor, Converter={StaticResource StringToBrushConverter}}" BorderThickness="1"
                CornerRadius="6" Padding="10,7">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding KindLabel}"
                               FontSize="9" FontWeight="Bold"
                               Foreground="{Binding KindColor, Converter={StaticResource StringToBrushConverter}}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding Title}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource PrimaryTextBrush}"
                           Margin="0,2,0,0" TextWrapping="Wrap"
                           Visibility="{Binding Detail, Converter={StaticResource StringToVisibilityConverter}}"/>
                <ItemsControl ItemsSource="{Binding Hints}" Margin="0,3,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,1,0,0">
                                <Run Text="• "/><Run Text="{Binding Mode=OneWay}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
