@using System.Globalization
@if (ViewModel != null)
{

    <div class="dps-meter-dynamic">
        <div class="header-module">
            <div class="header-top" @onmousedown="ViewModel.BeginDrag">
                <div class="header-row header-row-top">
                    <span class="boss-name" title="@ViewModel.ActiveTargetName">@ViewModel.ActiveTargetName</span>
                    <div class="global-stats">
                        <span class="stat-sm ping-group">
                            <span class="ping-bars" style="color:@ViewModel.PingColor">
                                <span class="ping-bar @(ViewModel.PingLevel >= 1 ? "active" : string.Empty)"></span>
                                <span class="ping-bar @(ViewModel.PingLevel >= 2 ? "active" : string.Empty)"></span>
                                <span class="ping-bar @(ViewModel.PingLevel >= 3 ? "active" : string.Empty)"></span>
                            </span>
                            <span style="color:@ViewModel.PingColor">@ViewModel.PingDisplay</span>
                        </span>
                        <span class="stat-sm">@ViewModel.CombatDuration</span>
                    </div>
                    <div class="header-controls">
                        <button type="button" class="control-btn" @onclick="ViewModel.ResetMeter" @onmousedown:stopPropagation="true" title="Reset meter (saves the current fight to history)">↺</button>
                        <button type="button" class="control-btn" @onclick="ViewModel.OpenHistory" @onmousedown:stopPropagation="true" title="History">☰</button>
                        <button type="button" class="control-btn" @onclick="ViewModel.OpenStatEffCalc" @onmousedown:stopPropagation="true" title="Stat Eff Calculator">⚔</button>
                        <button type="button" class="control-btn" @onclick="ViewModel.OpenSettings" @onmousedown:stopPropagation="true" title="Settings">⚙</button>
                        <button type="button" class="control-btn" @onclick="ViewModel.Minimize" @onmousedown:stopPropagation="true" title="Hide">_</button>
                        <button type="button" class="control-btn" @onclick="ViewModel.Close" @onmousedown:stopPropagation="true" title="Close">✕</button>
                    </div>
                </div>
                <div class="header-row header-row-bottom">
                    <span class="boss-hp">
                        @ViewModel.ActiveTargetHpDisplay
                        @if (!string.IsNullOrEmpty(ViewModel.TimeToKillDisplay))
                        {
                            <span class="boss-ttk" title="Estimated time to kill">· @ViewModel.TimeToKillDisplay</span>
                        }
                        @if (ViewModel.FrenzyBeforeKill)
                        {
                            <FrenzyWarningIcon Tooltip="@ViewModel.FrenzyWarningTooltip" />
                        }
                    </span>
                    <span class="dps-group">
                        @if (!string.IsNullOrEmpty(ViewModel.UserUptimeDisplay))
                        {
                            <span class="user-uptime" title="@ViewModel.UserUptimeTooltip">@ViewModel.UserUptimeDisplay</span>
                        }
                        <span class="total-dps">@ViewModel.TotalRaidDamageFormatted</span>
                    </span>
                </div>
            </div>
            <div class="boss-hp-track">
                <div class="boss-hp-fill" style="width:@($"{ViewModel.ClampPercent(ViewModel.ActiveTargetHpPercentage).ToString("0.##", CultureInfo.InvariantCulture)}%")"></div>
            </div>
        </div>

        <BossPatternBars Bars="@ViewModel.BossPatternBars" Boxed="true" />

        <div class="players-list">
            @foreach (var player in ViewModel.Players)
            {
                <div class="player-module @ViewModel.GetIsUserClass(player) @(ViewModel.ShowBreakBars ? "has-break" : string.Empty)" @onclick="() => ViewModel.OpenPlayerDetails(player)">
                    <div class="progress-bar @ViewModel.GetPlayerRowClass(player)" style="width:@($"{ViewModel.ClampPercent(player.EffectivePercentage).ToString("0.##", CultureInfo.InvariantCulture)}%")"></div>
                    <div class="player-data">
                        <div class="icon-wrap">
                            <div class="class-icon" style="background-image: url('/images/classes/@(player.ClassId).png');"></div>
                        </div>
                        <div class="player-info">
                            <div class="name-block">
                                @player.PlayerNameDisplay
                            </div>
                            <div class="score">@ViewModel.GetCombatScoreDisplay(player)</div>
                        </div>
                        <div></div>
                        <div class="death">@player.DeathsDisplay</div>
                        <div class="damage">@player.TotalDamageFormatted (@($"{player.DamagePercentage:F1}%"))</div>
                        <div class="dps">@player.DpsFormatted<span class="sub">/s</span></div>
                    </div>
                    @if (ViewModel.ShowBreakBars)
                    {
                        <div class="break-track" title="@player.BreakTooltip">
                            <div class="break-fill" style="width:@($"{ViewModel.ClampPercent(player.VisualBreakPercentage).ToString("0.##", CultureInfo.InvariantCulture)}%")"></div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}