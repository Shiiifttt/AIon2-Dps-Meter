@using AionDpsMeter.Services.Services.BossPatterns
@using AionDpsMeter.Services.Services.Session
@using AionDpsMeter.Services.Services.Settings
@using AionDpsMeter.UI.Services.Windowing
@using AionDpsMeter.UI.ViewModels
@implements IDisposable
@page "/"
@if(UiStyle == 1)
{
    <MainDpsStyle2 viewModel="@viewModel" />
}
else if (UiStyle == 3)
{
    <MainDpsUltraCompact ViewModel="@viewModel" />
}
else if (UiStyle == 4)
{
    <MainDpsHorizontal ViewModel="@viewModel" />
}
else
{
   <MainDpsMinimal viewModel="@viewModel" /> 
}

@code {
    [Inject] private CombatSessionManager SessionManager { get; set; } = null!;
    [Inject] private IAppSettingsService SettingsService { get; set; } = null!;
    [Inject] private IWindowManagerService WindowManager { get; set; } = null!;
    [Inject] private WindowHelper WindowHelper { get; set; } = null!;
    [Inject] private BossPatternTracker BossPatterns { get; set; } = null!;
    [Inject] private MeterLayoutMetrics LayoutMetrics { get; set; } = null!;
    [Inject] private Microsoft.JSInterop.IJSRuntime JS { get; set; } = null!;

    private sealed record LayoutMeasure(int Layout, double Header, double Bottom, double Pitch, double RowHeight);

    // The meter re-renders many times a second; measuring its layout now and then is plenty.
    private static readonly TimeSpan MeasureInterval = TimeSpan.FromMilliseconds(1500);
    private DateTime _lastMeasure = DateTime.MinValue;
    private int _measuredStyle;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Measure straight away after a layout switch, so the window can be fitted to it.
        if (UiStyle == _measuredStyle && DateTime.UtcNow - _lastMeasure < MeasureInterval) return;
        _lastMeasure = DateTime.UtcNow;
        _measuredStyle = UiStyle;
        try
        {
            var m = await JS.InvokeAsync<LayoutMeasure?>("aionMeter.measure", Array.Empty<object>());
            if (m is not null && m.Layout == UiStyle)
                LayoutMetrics.Report(m.Layout, m.Header, m.Bottom, m.Pitch, m.RowHeight);
        }
        catch (Exception)
        {
            // The page can be going away (closing, reloading); try again next time.
        }
    }

    private int UiStyle => SettingsService.UiStyle;

    private MainDpsViewModel? viewModel;

    protected override void OnInitialized()
    {
        viewModel = new MainDpsViewModel(SessionManager, SettingsService, WindowManager, WindowHelper, BossPatterns, () => InvokeAsync(StateHasChanged));
        viewModel.Initialize();
    }

    public void Dispose()
    {
        viewModel?.Dispose();
    }

}




